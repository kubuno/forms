{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "chrome",
      "request": "launch",
      "name": "Kubuno forms (Chrome)",
      "url": "http://localhost:8080/forms",
      "webRoot": "${workspaceFolder}",
      "sourceMapPathOverrides": { "http://localhost:8080/modules/forms/*": "${workspaceFolder}/dist/*" }
    }
    {
      "type": "edge",
      "request": "launch",
      "name": "Kubuno forms (Edge)",
      "url": "http://localhost:8080/forms",
      "webRoot": "${workspaceFolder}",
      "sourceMapPathOverrides": { "http://localhost:8080/modules/forms/*": "${workspaceFolder}/dist/*" }
    },
  ]
}
