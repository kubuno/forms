{
  "$schema": "https://github.com/kubuno/core/blob/main/vectors/conformance-vectors.schema.json",
  "format": 1,
  "suite": "forms.operators",
  "version": "1.0.0",
  "description": "A rule operator applied to an answer and the rule's compare value. Input: { operator, answer (absent = not answered), compare }. Output: true when the condition holds. Semantics are JavaScript's (String(), trim(), Number(), toLowerCase()).",
  "reference": "forms/crates/kubuno-forms-core logic::evaluate_operator; frontend/src/logic.ts evalOperator",
  "cases": [
    { "id": "is-empty/absent", "input": { "operator": "is_empty", "compare": null }, "expected": true },
    { "id": "is-empty/null", "input": { "operator": "is_empty", "answer": null, "compare": null }, "expected": true },
    { "id": "is-empty/blank-string", "input": { "operator": "is_empty", "answer": " \t\n ", "compare": null }, "expected": true },
    { "id": "is-empty/empty-array", "input": { "operator": "is_empty", "answer": [], "compare": null }, "expected": true },
    { "id": "is-empty/zero", "input": { "operator": "is_empty", "answer": 0, "compare": null }, "expected": false },
    { "id": "is-empty/false", "input": { "operator": "is_empty", "answer": false, "compare": null }, "expected": false },
    { "id": "is-empty/empty-object", "input": { "operator": "is_empty", "answer": {}, "compare": null }, "expected": false },
    { "id": "is-empty/nel-is-not-whitespace", "input": { "operator": "is_empty", "answer": "\u0085", "compare": null }, "expected": false, "note": "U+0085 is not trimmed by String.prototype.trim" },
    { "id": "is-not-empty/text", "input": { "operator": "is_not_empty", "answer": "x", "compare": null }, "expected": true },
    { "id": "is-not-empty/absent", "input": { "operator": "is_not_empty", "compare": null }, "expected": false },
    { "id": "equals/case-insensitive", "input": { "operator": "equals", "answer": "Oui", "compare": "OUI" }, "expected": true },
    { "id": "equals/no-trim", "input": { "operator": "equals", "answer": " oui", "compare": "oui" }, "expected": false },
    { "id": "equals/number-vs-string", "input": { "operator": "equals", "answer": 3, "compare": "3" }, "expected": true },
    { "id": "equals/float-formatting", "input": { "operator": "equals", "answer": 2.0, "compare": "2" }, "expected": true },
    { "id": "equals/decimal", "input": { "operator": "equals", "answer": 0.1, "compare": "0.1" }, "expected": true },
    { "id": "equals/large-number", "input": { "operator": "equals", "answer": 1e21, "compare": "1e+21" }, "expected": true },
    { "id": "equals/boolean", "input": { "operator": "equals", "answer": true, "compare": "TRUE" }, "expected": true },
    { "id": "equals/absent-vs-empty", "input": { "operator": "equals", "compare": "" }, "expected": true },
    { "id": "equals/absent-vs-null", "input": { "operator": "equals", "compare": null }, "expected": true },
    { "id": "equals/array-member", "input": { "operator": "equals", "answer": ["a", "b"], "compare": "b" }, "expected": true },
    { "id": "equals/array-case-sensitive", "input": { "operator": "equals", "answer": ["a", "b"], "compare": "B" }, "expected": false },
    { "id": "equals/array-number-member", "input": { "operator": "equals", "answer": [1, 2], "compare": 2 }, "expected": true },
    { "id": "equals/array-null-member", "input": { "operator": "equals", "answer": [null], "compare": null }, "expected": true, "note": "String(null) is 'null' on both sides" },
    { "id": "equals/empty-array-vs-empty", "input": { "operator": "equals", "answer": [], "compare": "" }, "expected": false },
    { "id": "equals/object", "input": { "operator": "equals", "answer": { "a": 1 }, "compare": "[object Object]" }, "expected": true },
    { "id": "equals/unicode-case", "input": { "operator": "equals", "answer": "ÉLÈVE", "compare": "élève" }, "expected": true },
    { "id": "not-equals/different", "input": { "operator": "not_equals", "answer": "a", "compare": "b" }, "expected": true },
    { "id": "not-equals/same", "input": { "operator": "not_equals", "answer": "A", "compare": "a" }, "expected": false },
    { "id": "not-equals/absent", "input": { "operator": "not_equals", "compare": "x" }, "expected": true },
    { "id": "contains/substring", "input": { "operator": "contains", "answer": "Bonjour Paris", "compare": "PARIS" }, "expected": true },
    { "id": "contains/empty-compare", "input": { "operator": "contains", "answer": "abc", "compare": "" }, "expected": true },
    { "id": "contains/null-compare", "input": { "operator": "contains", "answer": "abc", "compare": null }, "expected": true },
    { "id": "contains/array-exact-member", "input": { "operator": "contains", "answer": ["opt-1", "opt-2"], "compare": "opt-2" }, "expected": true },
    { "id": "contains/array-not-substring", "input": { "operator": "contains", "answer": ["opt-12"], "compare": "opt-1" }, "expected": false },
    { "id": "contains/number", "input": { "operator": "contains", "answer": 12345, "compare": 234 }, "expected": true },
    { "id": "not-contains/missing", "input": { "operator": "not_contains", "answer": "abc", "compare": "z" }, "expected": true },
    { "id": "not-contains/array-member", "input": { "operator": "not_contains", "answer": ["a"], "compare": "a" }, "expected": false },
    { "id": "starts-with/yes", "input": { "operator": "starts_with", "answer": "Kubuno Forms", "compare": "kub" }, "expected": true },
    { "id": "starts-with/array-joined", "input": { "operator": "starts_with", "answer": ["a", "b"], "compare": "a,b" }, "expected": true },
    { "id": "starts-with/absent", "input": { "operator": "starts_with", "compare": "" }, "expected": true },
    { "id": "ends-with/yes", "input": { "operator": "ends_with", "answer": "rapport.PDF", "compare": ".pdf" }, "expected": true },
    { "id": "ends-with/no", "input": { "operator": "ends_with", "answer": "rapport.pdf", "compare": ".doc" }, "expected": false },
    { "id": "greater-than/numbers", "input": { "operator": "greater_than", "answer": 7, "compare": 5 }, "expected": true },
    { "id": "greater-than/numeric-strings", "input": { "operator": "greater_than", "answer": " 10 ", "compare": "9.5" }, "expected": true },
    { "id": "greater-than/equal", "input": { "operator": "greater_than", "answer": 5, "compare": 5 }, "expected": false },
    { "id": "greater-than/not-a-number", "input": { "operator": "greater_than", "answer": "abc", "compare": 1 }, "expected": false },
    { "id": "greater-than/blank", "input": { "operator": "greater_than", "answer": "  ", "compare": -1 }, "expected": false, "note": "a blank string is not 0 here" },
    { "id": "greater-than/absent", "input": { "operator": "greater_than", "compare": -1 }, "expected": false },
    { "id": "greater-than/hex", "input": { "operator": "greater_than", "answer": "0x10", "compare": 15 }, "expected": true, "note": "Number('0x10') is 16" },
    { "id": "greater-than/exponent", "input": { "operator": "greater_than", "answer": "1e3", "compare": "999" }, "expected": true },
    { "id": "greater-than/infinity", "input": { "operator": "greater_than", "answer": "Infinity", "compare": 1e300 }, "expected": true },
    { "id": "greater-than/rust-inf-is-nan", "input": { "operator": "greater_than", "answer": "inf", "compare": 0 }, "expected": false },
    { "id": "greater-than/boolean", "input": { "operator": "greater_than", "answer": true, "compare": 0 }, "expected": false, "note": "booleans are not numbers for the logic" },
    { "id": "greater-than/array", "input": { "operator": "greater_than", "answer": [5], "compare": 1 }, "expected": false },
    { "id": "greater-or-equal/equal", "input": { "operator": "greater_or_equal", "answer": 5, "compare": "5" }, "expected": true },
    { "id": "less-than/yes", "input": { "operator": "less_than", "answer": "-2", "compare": 0 }, "expected": true },
    { "id": "less-than/trailing-garbage", "input": { "operator": "less_than", "answer": "3kg", "compare": 10 }, "expected": false },
    { "id": "less-or-equal/equal", "input": { "operator": "less_or_equal", "answer": 0.5, "compare": ".5" }, "expected": true },
    { "id": "less-or-equal/compare-null", "input": { "operator": "less_or_equal", "answer": 0, "compare": null }, "expected": false },
    { "id": "unknown-operator", "input": { "operator": "matches_regex", "answer": "a", "compare": "a" }, "expected": false }
  ]
}
