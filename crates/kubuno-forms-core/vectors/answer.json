{
  "$schema": "https://github.com/kubuno/core/blob/main/vectors/conformance-vectors.schema.json",
  "format": 1,
  "suite": "forms.answer",
  "version": "1.0.0",
  "description": "One value for one question. Input: { question: {id, question_type, required, options}, value (absent = no answer) }. Output: { answered, issue }: answered says whether the value counts as an answer (what a required question checks); issue is null or the code of the first problem of an answered value (invalid_type, invalid_choice, out_of_range, too_long, invalid_format). Unknown question types accept any value.",
  "reference": "forms/crates/kubuno-forms-core validate::check_answer; frontend/src/logic.ts checkAnswer",
  "cases": [
    { "id": "absent", "input": { "question": { "id": "q", "question_type": "short_text" } }, "expected": { "answered": false, "issue": null } },
    { "id": "short-text/ok", "input": { "question": { "id": "q", "question_type": "short_text" }, "value": "Ada" }, "expected": { "answered": true, "issue": null } },
    { "id": "short-text/blank", "input": { "question": { "id": "q", "question_type": "short_text" }, "value": "   " }, "expected": { "answered": false, "issue": null } },
    { "id": "short-text/number-is-wrong-type", "input": { "question": { "id": "q", "question_type": "short_text" }, "value": 42 }, "expected": { "answered": true, "issue": "invalid_type" } },
    { "id": "long-text/ok", "input": { "question": { "id": "q", "question_type": "long_text" }, "value": "line 1\nline 2" }, "expected": { "answered": true, "issue": null } },
    { "id": "content/never-answered", "input": { "question": { "id": "q", "question_type": "statement" }, "value": "x" }, "expected": { "answered": false, "issue": null } },
    { "id": "email/ok", "input": { "question": { "id": "q", "question_type": "email" }, "value": "ada.lovelace+forms@example.org" }, "expected": { "answered": true, "issue": null } },
    { "id": "email/trimmed", "input": { "question": { "id": "q", "question_type": "email" }, "value": " ada@example.org " }, "expected": { "answered": true, "issue": null } },
    { "id": "email/dotless-domain", "input": { "question": { "id": "q", "question_type": "email" }, "value": "admin@localhost" }, "expected": { "answered": true, "issue": null }, "note": "the browser's definition accepts it" },
    { "id": "email/no-at", "input": { "question": { "id": "q", "question_type": "email" }, "value": "ada.example.org" }, "expected": { "answered": true, "issue": "invalid_format" } },
    { "id": "email/two-ats", "input": { "question": { "id": "q", "question_type": "email" }, "value": "a@b@c" }, "expected": { "answered": true, "issue": "invalid_format" } },
    { "id": "email/space", "input": { "question": { "id": "q", "question_type": "email" }, "value": "ada lovelace@example.org" }, "expected": { "answered": true, "issue": "invalid_format" } },
    { "id": "email/label-hyphen", "input": { "question": { "id": "q", "question_type": "email" }, "value": "a@-example.org" }, "expected": { "answered": true, "issue": "invalid_format" } },
    { "id": "url/ok", "input": { "question": { "id": "q", "question_type": "url" }, "value": "https://kubuno.com/forms?x=1" }, "expected": { "answered": true, "issue": null } },
    { "id": "url/mailto", "input": { "question": { "id": "q", "question_type": "url" }, "value": "mailto:ada@example.org" }, "expected": { "answered": true, "issue": null } },
    { "id": "url/no-scheme", "input": { "question": { "id": "q", "question_type": "url" }, "value": "kubuno.com" }, "expected": { "answered": true, "issue": "invalid_format" } },
    { "id": "url/space", "input": { "question": { "id": "q", "question_type": "url" }, "value": "https://kubuno.com/a b" }, "expected": { "answered": true, "issue": "invalid_format" } },
    { "id": "number/number", "input": { "question": { "id": "q", "question_type": "number" }, "value": -12.5 }, "expected": { "answered": true, "issue": null } },
    { "id": "number/zero-is-an-answer", "input": { "question": { "id": "q", "question_type": "number" }, "value": 0 }, "expected": { "answered": true, "issue": null } },
    { "id": "number/numeric-string", "input": { "question": { "id": "q", "question_type": "number" }, "value": " 1e3 " }, "expected": { "answered": true, "issue": null } },
    { "id": "number/text", "input": { "question": { "id": "q", "question_type": "number" }, "value": "douze" }, "expected": { "answered": true, "issue": "invalid_format" } },
    { "id": "number/infinity", "input": { "question": { "id": "q", "question_type": "number" }, "value": "Infinity" }, "expected": { "answered": true, "issue": "invalid_format" } },
    { "id": "number/boolean", "input": { "question": { "id": "q", "question_type": "number" }, "value": true }, "expected": { "answered": true, "issue": "invalid_type" } },
    { "id": "phone/object", "input": { "question": { "id": "q", "question_type": "phone" }, "value": { "country": "FR", "number": "06 12 34 56 78", "label": "Mobile" } }, "expected": { "answered": true, "issue": null } },
    { "id": "phone/object-empty-number", "input": { "question": { "id": "q", "question_type": "phone" }, "value": { "country": "FR", "number": "" } }, "expected": { "answered": false, "issue": null } },
    { "id": "phone/string", "input": { "question": { "id": "q", "question_type": "phone" }, "value": "+33 (0)6 12-34-56-78" }, "expected": { "answered": true, "issue": null } },
    { "id": "phone/letters", "input": { "question": { "id": "q", "question_type": "phone" }, "value": { "country": "FR", "number": "call me" } }, "expected": { "answered": true, "issue": "invalid_format" } },
    { "id": "phone/too-long", "input": { "question": { "id": "q", "question_type": "phone" }, "value": "0123456789 0123456789 0123456789 0123456789" }, "expected": { "answered": true, "issue": "too_long" } },
    { "id": "choice/ok", "input": { "question": { "id": "q", "question_type": "multiple_choice", "options": { "options": [{ "id": "o1", "label": "A" }, { "id": "o2", "label": "B" }] } }, "value": "o2" }, "expected": { "answered": true, "issue": null } },
    { "id": "choice/label-is-not-an-id", "input": { "question": { "id": "q", "question_type": "multiple_choice", "options": { "options": [{ "id": "o1", "label": "A" }] } }, "value": "A" }, "expected": { "answered": true, "issue": "invalid_choice" } },
    { "id": "dropdown/array", "input": { "question": { "id": "q", "question_type": "dropdown", "options": { "options": [{ "id": "o1", "label": "A" }] } }, "value": ["o1"] }, "expected": { "answered": true, "issue": "invalid_type" } },
    { "id": "checkbox/ok", "input": { "question": { "id": "q", "question_type": "checkbox", "options": { "options": [{ "id": "o1" }, { "id": "o2" }, { "id": "o3" }] } }, "value": ["o3", "o1"] }, "expected": { "answered": true, "issue": null } },
    { "id": "checkbox/empty", "input": { "question": { "id": "q", "question_type": "checkbox", "options": { "options": [{ "id": "o1" }] } }, "value": [] }, "expected": { "answered": false, "issue": null } },
    { "id": "checkbox/duplicate", "input": { "question": { "id": "q", "question_type": "checkbox", "options": { "options": [{ "id": "o1" }] } }, "value": ["o1", "o1"] }, "expected": { "answered": true, "issue": "invalid_choice" } },
    { "id": "checkbox/unknown", "input": { "question": { "id": "q", "question_type": "checkbox", "options": { "options": [{ "id": "o1" }] } }, "value": ["o1", "o9"] }, "expected": { "answered": true, "issue": "invalid_choice" } },
    { "id": "ranking/ok", "input": { "question": { "id": "q", "question_type": "ranking", "options": { "options": [{ "id": "a" }, { "id": "b" }] } }, "value": ["b", "a"] }, "expected": { "answered": true, "issue": null } },
    { "id": "yes-no/ok", "input": { "question": { "id": "q", "question_type": "yes_no" }, "value": "no" }, "expected": { "answered": true, "issue": null } },
    { "id": "yes-no/other", "input": { "question": { "id": "q", "question_type": "yes_no" }, "value": "maybe" }, "expected": { "answered": true, "issue": "invalid_choice" } },
    { "id": "yes-no/boolean", "input": { "question": { "id": "q", "question_type": "yes_no" }, "value": true }, "expected": { "answered": true, "issue": "invalid_type" } },
    { "id": "linear-scale/default-range", "input": { "question": { "id": "q", "question_type": "linear_scale" }, "value": 5 }, "expected": { "answered": true, "issue": null } },
    { "id": "linear-scale/above", "input": { "question": { "id": "q", "question_type": "linear_scale", "options": { "min": 1, "max": 5 } }, "value": 6 }, "expected": { "answered": true, "issue": "out_of_range" } },
    { "id": "linear-scale/below", "input": { "question": { "id": "q", "question_type": "linear_scale", "options": { "min": 1, "max": 5 } }, "value": 0 }, "expected": { "answered": true, "issue": "out_of_range" } },
    { "id": "linear-scale/fraction", "input": { "question": { "id": "q", "question_type": "linear_scale", "options": { "min": 1, "max": 5 } }, "value": 2.5 }, "expected": { "answered": true, "issue": "out_of_range" } },
    { "id": "linear-scale/string", "input": { "question": { "id": "q", "question_type": "linear_scale" }, "value": "3" }, "expected": { "answered": true, "issue": "invalid_type" } },
    { "id": "opinion-scale/zero", "input": { "question": { "id": "q", "question_type": "opinion_scale" }, "value": 0 }, "expected": { "answered": true, "issue": null } },
    { "id": "opinion-scale/eleven", "input": { "question": { "id": "q", "question_type": "opinion_scale" }, "value": 11 }, "expected": { "answered": true, "issue": "out_of_range" } },
    { "id": "rating/max-from-options", "input": { "question": { "id": "q", "question_type": "rating", "options": { "max": 10, "icon": "heart" } }, "value": 10 }, "expected": { "answered": true, "issue": null } },
    { "id": "rating/zero", "input": { "question": { "id": "q", "question_type": "rating" }, "value": 0 }, "expected": { "answered": true, "issue": "out_of_range" } },
    { "id": "date/ok", "input": { "question": { "id": "q", "question_type": "date" }, "value": "2024-02-29" }, "expected": { "answered": true, "issue": null } },
    { "id": "date/not-leap", "input": { "question": { "id": "q", "question_type": "date" }, "value": "2023-02-29" }, "expected": { "answered": true, "issue": "invalid_format" } },
    { "id": "date/french-order", "input": { "question": { "id": "q", "question_type": "date" }, "value": "29/02/2024" }, "expected": { "answered": true, "issue": "invalid_format" } },
    { "id": "time/24h", "input": { "question": { "id": "q", "question_type": "time" }, "value": "09:05" }, "expected": { "answered": true, "issue": null } },
    { "id": "time/12h", "input": { "question": { "id": "q", "question_type": "time" }, "value": "9:05 pm" }, "expected": { "answered": true, "issue": null } },
    { "id": "time/seconds", "input": { "question": { "id": "q", "question_type": "time" }, "value": "23:59:59" }, "expected": { "answered": true, "issue": null } },
    { "id": "time/out-of-range", "input": { "question": { "id": "q", "question_type": "time" }, "value": "24:00" }, "expected": { "answered": true, "issue": "invalid_format" } },
    { "id": "birthday/full", "input": { "question": { "id": "q", "question_type": "birthday" }, "value": { "day": "29", "month": "2", "year": "2000" } }, "expected": { "answered": true, "issue": null } },
    { "id": "birthday/no-year-feb-29", "input": { "question": { "id": "q", "question_type": "birthday" }, "value": { "day": "29", "month": "2", "year": "" } }, "expected": { "answered": true, "issue": null } },
    { "id": "birthday/not-leap", "input": { "question": { "id": "q", "question_type": "birthday" }, "value": { "day": "29", "month": "2", "year": "1999" } }, "expected": { "answered": true, "issue": "invalid_format" } },
    { "id": "birthday/partial", "input": { "question": { "id": "q", "question_type": "birthday" }, "value": { "day": "12", "month": "", "year": "" } }, "expected": { "answered": true, "issue": "invalid_format" } },
    { "id": "birthday/empty", "input": { "question": { "id": "q", "question_type": "birthday" }, "value": { "day": "", "month": "", "year": "" } }, "expected": { "answered": false, "issue": null } },
    { "id": "birthday/year-out-of-range", "input": { "question": { "id": "q", "question_type": "birthday" }, "value": { "day": "1", "month": "1", "year": "99" } }, "expected": { "answered": true, "issue": "out_of_range" } },
    { "id": "address/ok", "input": { "question": { "id": "q", "question_type": "address" }, "value": { "street": "1 rue de la Paix", "postal": "75002", "city": "Paris", "country": "FR" } }, "expected": { "answered": true, "issue": null } },
    { "id": "address/empty", "input": { "question": { "id": "q", "question_type": "address" }, "value": { "street": "", "postal": "", "city": " ", "country": "" } }, "expected": { "answered": false, "issue": null } },
    { "id": "address/nested", "input": { "question": { "id": "q", "question_type": "address" }, "value": { "street": { "x": 1 } } }, "expected": { "answered": false, "issue": null }, "note": "no field holds text, so it is not an answer and is not checked" },
    { "id": "address/nested-with-text", "input": { "question": { "id": "q", "question_type": "address" }, "value": { "street": { "x": 1 }, "city": "Paris" } }, "expected": { "answered": true, "issue": "invalid_type" } },
    { "id": "field-group/ok", "input": { "question": { "id": "q", "question_type": "field_group", "options": { "fields": [{ "key": "first", "label": "Prénom" }, { "key": "last", "label": "Nom" }] } }, "value": { "first": "Ada", "last": "" } }, "expected": { "answered": true, "issue": null } },
    { "id": "field-group/unknown-key", "input": { "question": { "id": "q", "question_type": "field_group", "options": { "fields": [{ "key": "first", "label": "Prénom" }] } }, "value": { "first": "Ada", "admin": "yes" } }, "expected": { "answered": true, "issue": "invalid_choice" } },
    { "id": "grid-radio/ok", "input": { "question": { "id": "q", "question_type": "grid_radio", "options": { "rows": [{ "id": "r1" }, { "id": "r2" }], "columns": [{ "id": "c1" }, { "id": "c2" }] } }, "value": { "r1": "c2" } }, "expected": { "answered": true, "issue": null } },
    { "id": "grid-radio/empty", "input": { "question": { "id": "q", "question_type": "grid_radio", "options": { "rows": [{ "id": "r1" }], "columns": [{ "id": "c1" }] } }, "value": {} }, "expected": { "answered": false, "issue": null } },
    { "id": "grid-radio/unknown-column", "input": { "question": { "id": "q", "question_type": "grid_radio", "options": { "rows": [{ "id": "r1" }], "columns": [{ "id": "c1" }] } }, "value": { "r1": "c9" } }, "expected": { "answered": true, "issue": "invalid_choice" } },
    { "id": "grid-checkbox/ok", "input": { "question": { "id": "q", "question_type": "grid_checkbox", "options": { "rows": [{ "id": "r1" }], "columns": [{ "id": "c1" }, { "id": "c2" }] } }, "value": { "r1": ["c1", "c2"] } }, "expected": { "answered": true, "issue": null } },
    { "id": "grid-checkbox/string-cell", "input": { "question": { "id": "q", "question_type": "grid_checkbox", "options": { "rows": [{ "id": "r1" }], "columns": [{ "id": "c1" }] } }, "value": { "r1": "c1" } }, "expected": { "answered": true, "issue": "invalid_type" } },
    { "id": "file-upload/ok", "input": { "question": { "id": "q", "question_type": "file_upload" }, "value": { "fileId": "6f1c2b9e-1111-4c4c-8888-0123456789ab", "name": "cv.pdf", "size": 1024, "contentType": "application/pdf" } }, "expected": { "answered": true, "issue": null } },
    { "id": "file-upload/no-file", "input": { "question": { "id": "q", "question_type": "file_upload" }, "value": { "name": "cv.pdf" } }, "expected": { "answered": false, "issue": null } },
    { "id": "file-upload/string", "input": { "question": { "id": "q", "question_type": "file_upload" }, "value": "cv.pdf" }, "expected": { "answered": true, "issue": "invalid_type" } },
    { "id": "signature/ok", "input": { "question": { "id": "q", "question_type": "signature" }, "value": "data:image/png;base64,iVBORw0KGgo=" }, "expected": { "answered": true, "issue": null } },
    { "id": "signature/cleared", "input": { "question": { "id": "q", "question_type": "signature" }, "value": "" }, "expected": { "answered": false, "issue": null } },
    { "id": "signature/other-url", "input": { "question": { "id": "q", "question_type": "signature" }, "value": "https://example.org/sig.png" }, "expected": { "answered": true, "issue": "invalid_format" } },
    { "id": "unknown-type/any-value", "input": { "question": { "id": "q", "question_type": "future_type" }, "value": { "anything": [1, 2] } }, "expected": { "answered": true, "issue": null } }
  ]
}
